# Endpoint compatible OpenAI du runtime LLM local.
# LM Studio : http://localhost:1234/v1   (lms server start)
# Ollama    : http://localhost:11434/v1  (ollama serve)
LLM_BASE_URL=http://localhost:1234/v1

# Ignorée par un serveur local, mais exigée par le client OpenAI.
# Ce n'est pas un secret.
LLM_API_KEY=lm-studio
